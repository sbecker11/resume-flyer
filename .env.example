# Copy to .env and fill in secrets (API keys, tokens). Only .env.example is committed; .env is gitignored.

# Backend (Express) server port; also used as Vite proxy target when VITE_API_PORT is unset. 3001 avoids conflict with 3000.
EXPRESS_PORT=3001

# Vite dev server port. 5174 avoids conflict with apps on 5173; change for more instances.
VITE_DEV_PORT=5174

# Target for Vite proxy to backend. Uses EXPRESS_PORT unless VITE_API_PORT is set; set when running frontend dev alone.
# VITE_API_PORT=3001

# Parsed resumes directory used by the server.
PARSED_RESUMES_DIR=./parsed_resumes

# Path to the resume-parser project. The server/script uses <path>/venv/bin/python3.
RESUME_PARSER_PROJECT_PATH=../resume-parser

# S3 catalog endpoint and region for palette loading.
S3_COLOR_PALETTES_JSON_URL=https://sbecker11-color-palette-images.s3.us-west-1.amazonaws.com/metadata/color_palettes.jsonl
AWS_REGION=us-west-1

# Anthropic API — skill ? lookups + resume-parser (upload/reparse)
# Create keys at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Parser model (Sonnet default). Skill ? uses ANTHROPIC_SKILL_INFO_MODEL (Haiku default).
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_SKILL_INFO_MODEL=claude-haiku-4-5
# LLM_PROVIDER=anthropic

# Admin API key for usage/cost reports (npm run anthropic-usage) — sk-ant-admin...
# Create at https://console.anthropic.com/settings/admin-keys
# ANTHROPIC_ADMIN_API_KEY=

# Warn when period cost exceeds this USD (scripts/anthropic-usage-report.mjs)
# ANTHROPIC_MONTHLY_ALERT_USD=25

# Deprecated — skill lookups no longer use OpenAI. Safe to remove.
# OPENAI_API_KEY=

# Base URL prefix for external skill-definition source links shown in skill-info-modal.
# Example: with slug "hipaa" => http://wikipedia.com/wiki/hipaa
# Google variant (search query style): https://www.google.com/search?q=
VITE_SKILL_INFO_SOURCE_BASE_URL=http://wikipedia.com/wiki/

# Set to true to simulate GitHub Pages static mode locally (no server API calls).
# Alternatively toggle at runtime: window.enableStaticMode() / window.disableStaticMode()
# VITE_STATIC_MODE=true
